# Orbit configuration. Copy to .env.local and uncomment what you need.
# With nothing set, Orbit runs as a single user on a built-in database in .orbit-data/.

# ─── App & Domains ───────────────────────────────────────────────────────────
# Public URL people open Orbit at. OAuth callbacks go to ${APP_URL}/api/auth/callback/<provider>.
# APP_URL=http://localhost:3000
# Port the API listens on (the web app proxies /api/* to it).
# API_PORT=8787
# API_URL=http://localhost:8787

# Subdomain Separation:
# In Production:
# NEXT_PUBLIC_MARKETING_URL=https://orbit.io
# NEXT_PUBLIC_APP_URL=https://app.orbit.io
# STRICT_SUBDOMAINS=true
#
# In Local Dev (modern browsers resolve *.localhost automatically):
# NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://app.localhost:3000

# ─── Data ────────────────────────────────────────────────────────────────────
# Folder for the built-in database and uploaded images.
# ORBIT_DATA_DIR=.orbit-data
# Use your own Postgres instead of the built-in database (requires BETTER_AUTH_SECRET).
# DATABASE_URL=postgresql://user:password@localhost:5432/orbit

# ─── Team sign-in ────────────────────────────────────────────────────────────
# Setting this turns on accounts (email + password). Use 32+ random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BETTER_AUTH_SECRET=

# Each provider is enabled when both values are set.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_ISSUER=https://gitlab.com
