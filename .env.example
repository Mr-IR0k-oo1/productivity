# Environment Variables Template
# Copy this file to .env.local and fill in your values.
# Never commit real credentials.

# =====================
# SUPABASE (Public - exposed to browser)
# =====================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# =====================
# SUPABASE (Server-side only)
# =====================
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# =====================
# DATABASE (Server-side only)
# =====================
# Use value-only URL (no surrounding quotes, no DATABASE_URL= prefix inside the value).
DATABASE_URL=postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# =====================
# APP CONFIG
# =====================
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
API_URL=http://localhost:8787

# =====================
# OPTIONAL: WORKSPACE / DESKTOP FLAGS
# =====================
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=
ORBIT_DESKTOP_EXPORT=false

# =====================
# OPTIONAL: LOCAL DEV AUTH BYPASS (NEVER true in production)
# =====================
ORBIT_DISABLE_AUTH=false
NEXT_PUBLIC_ORBIT_DISABLE_AUTH=false
